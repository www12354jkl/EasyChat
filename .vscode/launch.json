        },
        {
            "type": "java",
            "name": "Chat-2 (8084/8085)",
            "request": "launch",
            "mainClass": "com.faust.easychat.ChatApplication",
            "projectName": "easychat-chat",
            "args": [
                "--spring.profiles.active=local",
                "--server.port=8084",
                "--ws.port=8085",
                "--spring.cloud.sentinel.transport.port=8722",
